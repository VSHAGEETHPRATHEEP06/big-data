) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 11), 0)) AS \"11\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 12) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 12), 0)) AS \"12\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 13) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 13), 0)) AS \"13\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 14) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 14), 0)) AS \"14\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 15) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 15), 0)) AS \"15\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 16) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 16), 0)) AS \"16\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 17) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 17), 0)) AS \"17\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 18) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 18), 0)) AS \"18\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 19) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 19), 0)) AS \"19\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 20) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 20), 0)) AS \"20\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 21) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 21), 0)) AS \"21\", round(100.0 * sum(on_trip_pings) FILTER (WHERE extract(hour FROM window_start) = 22) / nullif(sum(pings) FILTER (WHERE extract(hour FROM window_start) = 22), 0)) AS \"22\", round(1