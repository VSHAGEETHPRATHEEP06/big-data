        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT vehicle_id AS vehicle, vehicle_type AS type, trips, round(revenue_lkr) AS fares, round(total_cost_lkr) AS costs, round(net_profit_lkr) AS net_profit, round(margin_pct) AS margin, lower(trend) AS trend, status, array_to_string(reasons, ' | ') AS reasons FROM batch.vehicle_profitability WHERE sim_date = '${sim_date}' ORDER BY net_profit_lkr",
