    {
      "id": 13,
      "type": "table",
      "title": "Fares by zone and hour of day (thousand LKR)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 13
      },
      "datasource": {
