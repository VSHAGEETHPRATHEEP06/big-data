          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT zone, round(sum(earnings_lkr) FILTER (WHERE hour = 0) / 1000, 1) AS \"00\", round(sum(earnings_lkr) FILTER (WHERE hour = 1) / 1000, 1) AS \"01\", round(sum(earnings_lkr) FILTER (WHERE hour = 2) / 1000, 1) AS \"02\", round(sum(earnings_lkr) FILTER (WHERE hour = 3) / 1000, 1) AS \"03\", round(sum(earnings_lkr) FILTER (WHERE hour = 4) / 1000, 1) AS \"04\", round(sum(earnings_lkr) FILTER (WHERE hour = 5) / 1000, 1) AS \"05\", round(sum(earnings_lkr) FILTER (WHERE hour = 6) / 1000, 1) AS \"06\", round(sum(earnings_lkr) FILTER (WHERE hour = 7) / 1000, 1) AS \"07\", round(sum(earnings_lkr) FILTER (WHERE hour = 8) / 1000, 1) AS \"08\", round(sum(earnings_lkr) FILTER (WHERE hour = 9) / 1000, 1) AS \"09\", round(sum(earnings_lkr) FILTER (WHERE hour = 10) / 1000, 1) AS \"10\", round(sum(earnings_lkr) FILTER (WHERE hour = 11) / 1000, 1) AS \"11\", round(sum(earnings_lkr) FILTER (WHERE hour = 12) / 1000, 1) AS \"12\", round(sum(earnings_lkr) FILTER (WHERE hour = 13) / 1000, 1) AS \"13\", round(sum(earnings_lkr) FILTER (WHERE hour = 14) / 1000, 1) AS \"14\", round(sum(earnings_lkr) FILTER (WHERE hour = 15) / 1000, 1) AS \"15\", round(sum(earnings_lkr) FILTER (WHERE hour = 16) / 1000, 1) AS \"16\", round(sum(earnings_lkr) FILTER (WHERE hour = 17) / 1000, 1) AS \"17\", round(sum(earnings_lkr) FILTER (WHERE hour = 18) / 1000, 1) AS \"18\", round(sum(earnings_lkr) FILTER (WHERE hour = 19) / 1000, 1) AS \"19\", round(sum(earnings_lkr) FILTER (WHERE hour = 20) / 1000, 1) AS \"20\", round(sum(earnings_lkr) FILTER (WHERE hour = 21) / 1000, 1) AS \"21\", round(sum(earnings_lkr) FILTER (WHERE hour = 22) / 1000, 1) AS \"22\", round(sum(earnings_lkr) FILTER (WHERE hour = 23) / 1000, 1) AS \"23\" FROM batch.zone_hourly WHERE sim_date = '${sim_date}' GROUP BY zone ORDER BY sum(earnings_lkr) DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
