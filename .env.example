# FleetPulse configuration. Copy this file to .env before the first start:
#     cp .env.example .env
COMPOSE_PROJECT_NAME=fleetpulse

# ---- simulated clock -----------------------------------------------------
# 1 real second = SIM_SPEEDUP simulated seconds.
# 120 -> 1 simulated hour = 30 real seconds, 1 simulated day = 12 real minutes.
SIM_SPEEDUP=120
# Simulated start time (Sri Lanka local time, no offset)
SIM_START=2026-09-01T06:00:00
SIM_SEED=2026

# ---- streaming source (fleet telemetry) ------------------------------------
TICK_SECONDS=1.0
INVALID_EVENT_RATE=0.005
DUPLICATE_EVENT_RATE=0.01
OUTAGE_RATE_PER_SIM_HOUR=0.03

# ---- daily batch source (partner expense file) -----------------------------
EXPENSE_FAULT_RATE=0.6
# set to 1.0 to make every partner file late (demo of the "file missing" alert)
LATE_FILE_RATE=0.0
FUEL_PRICE_LKR=305

# ---- speed layer -------------------------------------------------------------
WATERMARK_MINUTES=10
SPEED_TRIGGER_SECONDS=5
AGGREGATE_TRIGGER_SECONDS=10
ARCHIVE_TRIGGER_SECONDS=30
IDLE_ALERT_MINUTES=90
OFFLINE_AFTER_MINUTES=30

# ---- business rules ------------------------------------------------------------
DRIVER_SHARE=0.30
AT_RISK_MARGIN_PCT=15
DISTANCE_GAP_ALERT_PCT=15
LOW_TRIPS_FACTOR=0.6
HIGH_FUEL_COST_FACTOR=1.25

# ---- PostgreSQL ------------------------------------------------------------------
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet_pw
AIRFLOW_DB_PASSWORD=airflow_pw
GRAFANA_DB_PASSWORD=grafana_pw

# ---- Airflow (local demo values, change them for any shared deployment) ----------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=P_QJVxsn6-X_pN1VU6ZqgHfwxBTWUV9PPzygYTs3IHI=
AIRFLOW_JWT_SECRET=ZmN9wy6haZB1LuCLHjkhqciZhqZuomK3

# ---- Grafana ---------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin

LOG_LEVEL=INFO
